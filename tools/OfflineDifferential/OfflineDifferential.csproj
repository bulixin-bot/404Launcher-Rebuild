<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <UseAppHost>false</UseAppHost>
    <RuntimeFrameworkVersion>9.0.20</RuntimeFrameworkVersion>
    <LocalRuntimePath Condition="'$(LocalRuntimePath)' == ''">C:\Program Files\dotnet\shared\Microsoft.NETCore.App\9.0.20</LocalRuntimePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>../../lib/Mono.Cecil.dll</HintPath></Reference>
    <Reference Exclude="$(LocalRuntimePath)\System.IO.Compression.Native.dll" Include="$(LocalRuntimePath)\System.*.dll;$(LocalRuntimePath)\Microsoft.CSharp.dll;$(LocalRuntimePath)\Microsoft.VisualBasic*.dll;$(LocalRuntimePath)\mscorlib.dll;$(LocalRuntimePath)\netstandard.dll;$(LocalRuntimePath)\WindowsBase.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>


